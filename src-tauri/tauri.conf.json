{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scanshelf",
  "version": "0.3.3",
  "identifier": "com.nobel6018.scanshelf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "scanshelf",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/library/**",
          "$APPCACHE/thumbs/**",
          "$APPCACHE/previews/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "scanshelf"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEN0EzNzVCRTlEMDBFMjQKUldRa0R0RHBXemQ2TGFscGFmVHNlTG5PZS9jOXFkR2ZHZHhaUzVQNUxmOFVsQnJDUGtieVhuemgK",
      "endpoints": [
        "https://github.com/nobel6018/scanshelf/releases/latest/download/latest.json"
      ]
    }
  }
}
